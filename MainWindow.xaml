<Window x:Class="UltraYoutubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultra YouTube Downloader"
        Width="760" Height="860"
        MinWidth="560" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource MainWindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        Closing="Window_Closing">

    <DockPanel>
        <!-- Meni — tekstovi se postavljaju iz LanguageManager-a (ApplyLanguage) -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource PanelBg2}" Foreground="{DynamicResource TextPrimary}"
              x:Name="mnuMain">
            <MenuItem x:Name="mnuFileRoot" Header="_File">
                <MenuItem x:Name="mnuPasteLinks" Header="_Add links from clipboard" InputGestureText="Ctrl+Shift+V" Click="MnuPasteLinks_Click"/>
                <MenuItem x:Name="mnuImportLinks" Header="_Import links from a text file..." Click="MnuImportLinks_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuExit" Header="E_xit" InputGestureText="Alt+F4" Click="MnuExit_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuViewRoot" Header="_View">
                <MenuItem x:Name="mnuThemeRoot" Header="Theme">
                    <MenuItem x:Name="mnuThemeDark" Header="_Dark (default)" IsCheckable="True" Click="ThemeMenuItem_Click" Tag="dark"/>
                    <MenuItem x:Name="mnuThemeLight" Header="_Light" IsCheckable="True" Click="ThemeMenuItem_Click" Tag="light"/>
                    <MenuItem x:Name="mnuThemeContrast" Header="_High contrast" IsCheckable="True" Click="ThemeMenuItem_Click" Tag="contrast"/>
                </MenuItem>
                <MenuItem x:Name="mnuTextSizeRoot" Header="Text size">
                    <MenuItem x:Name="mnuLarger" Header="_Larger text" InputGestureText="Ctrl++" Click="LargerText_Click"/>
                    <MenuItem x:Name="mnuSmaller" Header="_Smaller text" InputGestureText="Ctrl+-" Click="SmallerText_Click"/>
                    <MenuItem x:Name="mnuReset" Header="_Reset text size" InputGestureText="Ctrl+0" Click="ResetText_Click"/>
                </MenuItem>
                <MenuItem x:Name="mnuLanguageRoot" Header="_Language">
                    <MenuItem x:Name="mnuLangEn" Header="_English" IsCheckable="True" Click="LanguageMenuItem_Click" Tag="en"/>
                    <MenuItem x:Name="mnuLangSr" Header="_Serbian (Srpski)" IsCheckable="True" Click="LanguageMenuItem_Click" Tag="sr"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="mnuOpenFolderItem" Header="_Open destination folder" Click="MnuOpenFolder_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuToolsRoot" Header="_Tools">
                <MenuItem x:Name="mnuSettings" Header="_Settings..." InputGestureText="Ctrl+," Click="MnuSettings_Click"/>
                <MenuItem x:Name="mnuUpdateYtdlp" Header="_Update yt-dlp" Click="MnuUpdateYtdlp_Click"/>
                <MenuItem x:Name="mnuInstallDeno" Header="Install _Deno (for YouTube)" Click="MnuInstallDeno_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuHelpRoot" Header="_Help">
                <MenuItem x:Name="mnuShortcuts" Header="_Keyboard shortcuts" InputGestureText="F1" Click="MnuShortcuts_Click"/>
                <MenuItem x:Name="mnuSites" Header="_Supported sites (web page)" Click="MnuSites_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuSupport" Header="How to support this _project" Click="MnuSupport_Click"/>
                <MenuItem x:Name="mnuAboutItem" Header="_About" Click="MnuAbout_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="20,14,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0 naslov -->
                <RowDefinition Height="Auto"/>  <!-- 1 linkovi -->
                <RowDefinition Height="Auto"/>  <!-- 2 podrazumevano -->
                <RowDefinition Height="*"/>     <!-- 3 lista -->
                <RowDefinition Height="Auto"/>  <!-- 4 dugmad liste -->
                <RowDefinition Height="Auto"/>  <!-- 5 napredak -->
                <RowDefinition Height="Auto"/>  <!-- 6 verzija -->
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="txbAppTitle" Text="Ultra YouTube Downloader"
                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Name="txbAppSubtitle" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- LINKOVI: jedan ili više (svaki u svom redu, ili nalepljen ceo tekst sa linkovima) -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label x:Name="lblUrl" Grid.ColumnSpan="3" Content="Links:" Target="{Binding ElementName=txtUrl}" Padding="0,0,0,4"/>
                <TextBox x:Name="txtUrl" Grid.Row="1" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="56" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="TxtUrl_PreviewKeyDown"/>
                <Button x:Name="btnAdd" Grid.Row="1" Grid.Column="2" Content="Add to list" VerticalAlignment="Top"
                        Style="{StaticResource PrimaryBtn}" Click="BtnAdd_Click"/>
            </Grid>

            <!-- PODRAZUMEVANO: pamti se odmah i važi za svaki sledeći link -->
            <GroupBox Grid.Row="2" x:Name="grpDefaults" Header="Defaults" Margin="0,0,0,10">
                <StackPanel Margin="8,6,8,8">
                    <TextBlock x:Name="txbDefaultsHint" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="rbVideo" Content="Video" GroupName="FileType" Checked="FormatType_Changed"/>
                        <RadioButton x:Name="rbAudio" Content="Audio" GroupName="FileType" Checked="FormatType_Changed"/>
                    </StackPanel>

                    <Grid x:Name="pnlVideo">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label x:Name="lblQuality" Content="Video quality:" Target="{Binding ElementName=cmbQuality}" Padding="0,0,0,3"/>
                            <ComboBox x:Name="cmbQuality" SelectionChanged="Defaults_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label x:Name="lblContainer" Content="Video format:" Target="{Binding ElementName=cmbContainer}" Padding="0,0,0,3"/>
                            <ComboBox x:Name="cmbContainer" SelectionChanged="Defaults_Changed"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="pnlAudio" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label x:Name="lblAudioFormat" Content="Audio format:" Target="{Binding ElementName=cmbAudioFormat}" Padding="0,0,0,3"/>
                            <ComboBox x:Name="cmbAudioFormat" SelectionChanged="Defaults_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label x:Name="lblAudioQuality" Content="Audio quality:" Target="{Binding ElementName=cmbAudioQuality}" Padding="0,0,0,3"/>
                            <ComboBox x:Name="cmbAudioQuality" SelectionChanged="Defaults_Changed"/>
                        </StackPanel>
                    </Grid>

                    <Label x:Name="lblSaveFolder" Content="Save to folder:" Target="{Binding ElementName=txtSaveFolder}" Padding="0,8,0,3"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtSaveFolder" Grid.Column="0" IsReadOnly="True"/>
                        <Button x:Name="btnBrowseFolder" Grid.Column="2" Content="Browse..." Click="BtnBrowseFolder_Click"/>
                        <Button x:Name="btnOpenFolder" Grid.Column="4" Content="Open" Click="MnuOpenFolder_Click"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- LISTA ZA PREUZIMANJE -->
            <DockPanel Grid.Row="3" Margin="0,0,0,8">
                <Label x:Name="lblQueue" DockPanel.Dock="Top" Content="Download list:" Target="{Binding ElementName=lstQueue}" Padding="0,0,0,4"/>
                <ListBox x:Name="lstQueue" MinHeight="140" SelectionMode="Extended"
                         DisplayMemberPath="Display"
                         KeyDown="LstQueue_KeyDown" MouseDoubleClick="LstQueue_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <!-- Ime stavke = ceo opis (naslov, sajt, format, stanje) — to JAWS čita -->
                            <Setter Property="AutomationProperties.Name" Value="{Binding Display}"/>
                            <Setter Property="Padding" Value="4,3"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <WrapPanel Grid.Row="4" Margin="0,0,0,8">
                <Button x:Name="btnStartAll" Content="Download all" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,6" Click="BtnStartAll_Click"/>
                <Button x:Name="btnStopAll" Content="Stop" Margin="0,0,8,6" Click="BtnStopAll_Click"/>
                <Button x:Name="btnItemOptions" Content="Options for selected..." Margin="0,0,8,6" Click="BtnItemOptions_Click"/>
                <Button x:Name="btnRemove" Content="Remove selected" Margin="0,0,8,6" Click="BtnRemove_Click"/>
                <Button x:Name="btnRetry" Content="Retry failed" Margin="0,0,8,6" Click="BtnRetry_Click"/>
                <Button x:Name="btnClearDone" Content="Clear finished" Margin="0,0,8,6" Click="BtnClearDone_Click"/>
            </WrapPanel>

            <StackPanel Grid.Row="5">
                <ProgressBar x:Name="prgOverall" Height="10" Minimum="0" Maximum="100" Value="0"
                             Background="{DynamicResource ControlBg}" Foreground="#0078D4"/>
                <TextBlock x:Name="txbProgress" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>

            <TextBlock Grid.Row="6" x:Name="txbAppStatus" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Right" Margin="0,6,0,0"/>
        </Grid>
    </DockPanel>
</Window>
