<Window x:Class="UltraYoutubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultra YouTube Downloader"
        Width="600" Height="780"
        MinWidth="520" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource MainWindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        AutomationProperties.Name="Ultra YouTube Downloader — download video or audio from YouTube">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Meni -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource PanelBg2}" Foreground="{DynamicResource TextPrimary}"
              AutomationProperties.Name="Main menu">
            <MenuItem x:Name="mnuViewRoot" Header="_View">
                <MenuItem x:Name="mnuThemeRoot" Header="Theme">
                    <MenuItem x:Name="mnuThemeDark" Header="_Dark (default)" IsCheckable="True"
                              Click="ThemeMenuItem_Click" Tag="dark"/>
                    <MenuItem x:Name="mnuThemeLight" Header="_Light" IsCheckable="True"
                              Click="ThemeMenuItem_Click" Tag="light"/>
                    <MenuItem x:Name="mnuThemeContrast" Header="_High contrast" IsCheckable="True"
                              Click="ThemeMenuItem_Click" Tag="contrast"/>
                </MenuItem>
                <MenuItem x:Name="mnuTextSizeRoot" Header="Text size">
                    <MenuItem x:Name="mnuLarger" Header="_Larger text (Ctrl +)" Click="LargerText_Click"/>
                    <MenuItem x:Name="mnuSmaller" Header="_Smaller text (Ctrl -)" Click="SmallerText_Click"/>
                    <MenuItem x:Name="mnuReset" Header="_Reset text size (Ctrl 0)" Click="ResetText_Click"/>
                </MenuItem>
                <MenuItem x:Name="mnuLanguageRoot" Header="_Language">
                    <MenuItem x:Name="mnuLangEn" Header="_English" IsCheckable="True"
                              Click="LanguageMenuItem_Click" Tag="en"/>
                    <MenuItem x:Name="mnuLangSr" Header="_Serbian (Srpski)" IsCheckable="True"
                              Click="LanguageMenuItem_Click" Tag="sr"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="mnuOpenFolderItem" Header="_Open destination folder" Click="MnuOpenFolder_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuHelpRoot" Header="_Help">
                <MenuItem x:Name="mnuAboutItem" Header="_About Ultra YouTube Downloader" Click="MnuAbout_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0  Naslov -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>  <!-- 2  URL -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>  <!-- 4  Tip -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>  <!-- 6  Kvalitet (video ili audio) -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>  <!-- 8  Save to folder -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>  <!-- 10 Info panel (+ playlist scope) -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>  <!-- 12 Progress -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>  <!-- 14 Dugmici -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>  <!-- 16 Status/verzija -->
            </Grid.RowDefinitions>

            <!-- Naslov -->
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="txbAppTitle"
                           Text="Ultra YouTube Downloader"
                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Name="txbAppSubtitle"
                           Text="Download video (MP4) or audio (MP3) from a YouTube link."
                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- URL -->
            <StackPanel Grid.Row="2">
                <Label x:Name="lblUrl" Content="YouTube URL (video or playlist):" Target="{Binding ElementName=txtUrl}"/>
                <TextBox x:Name="txtUrl" KeyDown="TxtUrl_KeyDown"/>
            </StackPanel>

            <!-- Tip fajla -->
            <GroupBox Grid.Row="4"
                      x:Name="grpFileType"
                      Header="File type"
                      Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ThemeBorderBrush}">
                <StackPanel Orientation="Horizontal" Margin="8,6">
                    <RadioButton x:Name="rbVideo" Content="Video (MP4)" IsChecked="True"
                                 GroupName="FileType"
                                 Checked="FormatType_Changed"/>
                    <RadioButton x:Name="rbAudio" Content="Audio (MP3)"
                                 GroupName="FileType"
                                 Checked="FormatType_Changed"/>
                </StackPanel>
            </GroupBox>

            <!-- Kvalitet -->
            <StackPanel Grid.Row="6" x:Name="pnlQuality">
                <Label x:Name="lblQuality" Content="Video quality:" Target="{Binding ElementName=cmbQuality}"/>
                <ComboBox x:Name="cmbQuality" SelectedIndex="0">
                    <ComboBoxItem x:Name="cmbQBest" Content="Best available" Tag="best"/>
                    <ComboBoxItem x:Name="cmbQ1080" Content="1080p" Tag="1080"/>
                    <ComboBoxItem x:Name="cmbQ720" Content="720p" Tag="720"/>
                    <ComboBoxItem x:Name="cmbQ480" Content="480p" Tag="480"/>
                    <ComboBoxItem x:Name="cmbQ360" Content="360p" Tag="360"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="6" x:Name="pnlAudioQuality" Visibility="Collapsed">
                <Label x:Name="lblAudioQuality" Content="MP3 quality:" Target="{Binding ElementName=cmbAudioQuality}"/>
                <ComboBox x:Name="cmbAudioQuality" SelectedIndex="2">
                    <ComboBoxItem x:Name="cmbAQBest" Content="Best (VBR, largest file)" Tag="0"/>
                    <ComboBoxItem x:Name="cmbAQ320" Content="320 kbps" Tag="320K"/>
                    <ComboBoxItem x:Name="cmbAQ192" Content="192 kbps (recommended)" Tag="192K"/>
                    <ComboBoxItem x:Name="cmbAQ128" Content="128 kbps (smaller file)" Tag="128K"/>
                </ComboBox>
            </StackPanel>

            <!-- Save to folder -->
            <StackPanel Grid.Row="8">
                <Label x:Name="lblSaveFolder" Content="Save to folder:" Target="{Binding ElementName=txtSaveFolder}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtSaveFolder" Grid.Column="0" IsReadOnly="True"/>
                    <Button x:Name="btnBrowseFolder" Grid.Column="2"
                            Content="Browse..."
                            Click="BtnBrowseFolder_Click"/>
                    <Button x:Name="btnOpenFolder" Grid.Column="4"
                            Content="Open"
                            Click="MnuOpenFolder_Click"/>
                </Grid>
            </StackPanel>

            <!-- Info panel (pojavljuje se nakon fetch-a), sadrži i izbor obima plejliste -->
            <Border Grid.Row="10"
                    x:Name="pnlInfo"
                    Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12,10"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="txbInfoTitle"
                               Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="txbInfoMeta"
                               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>

                    <!-- Prikazuje se samo kada link vodi na plejlistu -->
                    <StackPanel x:Name="pnlPlaylistTracks" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock x:Name="txbPlaylistPrompt"
                                   Text="This link is part of a playlist. What do you want to download?"
                                   Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>

                        <GroupBox x:Name="grpScope"
                                  Header="Download scope"
                                  Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ThemeBorderBrush}">
                            <StackPanel Margin="8,6">
                                <RadioButton x:Name="rbScopeSingle"
                                             Content="Just this video (ignore the rest of the playlist)"
                                             GroupName="PlaylistScope"
                                             Margin="0,0,0,4"
                                             Checked="PlaylistScope_Changed"/>
                                <RadioButton x:Name="rbScopeAll"
                                             Content="Entire playlist"
                                             GroupName="PlaylistScope"
                                             Margin="0,0,0,4"
                                             Checked="PlaylistScope_Changed"/>
                                <RadioButton x:Name="rbScopeChoose"
                                             Content="Choose specific tracks..."
                                             GroupName="PlaylistScope"
                                             Checked="PlaylistScope_Changed"/>
                            </StackPanel>
                        </GroupBox>

                        <ListBox x:Name="lstPlaylistTracks"
                                 Height="110" Margin="0,8,0,0"
                                 Visibility="Collapsed"
                                 SelectionMode="Multiple"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Progress -->
            <StackPanel Grid.Row="12" x:Name="pnlProgress" Visibility="Collapsed">
                <ProgressBar x:Name="prgDownload"
                             Height="10" Minimum="0" Maximum="100" Value="0"
                             Background="{DynamicResource ControlBg}" Foreground="#0078D4"/>
                <!-- Bez static AutomationProperties.Name namerno, isto kao u dijalogu unutar
                     UltraVideoEditor-a: tekst se menja često i mora ostati čitljiv za JAWS/NVDA. -->
                <TextBlock x:Name="txbProgress"
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>

            <!-- Dugmici -->
            <Grid Grid.Row="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnFetchInfo"
                        Grid.Column="0"
                        Content="Load info"
                        Style="{StaticResource PrimaryBtn}"
                        Click="BtnFetchInfo_Click"/>

                <Button x:Name="btnDownload"
                        Grid.Column="2"
                        Content="Download"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryBtn}"
                        Click="BtnDownload_Click"/>

                <Button x:Name="btnCancel"
                        Grid.Column="4"
                        Content="Cancel"
                        Background="{DynamicResource PanelBg2}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"
                        Click="BtnCancel_Click"/>
            </Grid>

            <!-- Status / verzija -->
            <TextBlock Grid.Row="16"
                       x:Name="txbAppStatus"
                       FontSize="11" Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Right"/>
        </Grid>
    </DockPanel>
</Window>
